# Copy to .env and fill in. .env is gitignored.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payments
POSTGRES_PORT=5432
DEBEZIUM_PASSWORD=change-me
# Lakehouse (step 4): object storage keys and the Iceberg catalog database
LAKEHOUSE_S3_ACCESS_KEY=change-me
LAKEHOUSE_S3_SECRET_KEY=change-me-at-least-8-chars
ICEBERG_CATALOG_PASSWORD=change-me
# Silver (step 5): secret key for hashing customer emails (HMAC-SHA256)
PII_HASH_KEY=change-me-to-a-long-random-string
# Airflow (step 7): metadata database, connection encryption key, internal API token secret
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_FERNET_KEY=generate-with-python-cryptography-Fernet.generate_key
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
